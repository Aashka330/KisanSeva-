# KisanSeva Real API Configuration
# Copy this file to .env and fill in your keys.

# ── OpenWeatherMap (FREE tier: 60 calls/min, 1000/day) ──────────────────────
# 1. Sign up at https://openweathermap.org/
# 2. Go to API Keys at https://home.openweathermap.org/api_keys
# 3. Copy your key below
VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Enables: Real-time weather, 7-day forecast, AQI, GPS location, farming recs

# ── Google Gemini API (FREE tier: generous limits) ────────────────────────────
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Create an API key (free, no credit card)
# 3. Copy your key below
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Enables: Real AI farming chat, fertilizer & pesticide predictions
